# Email API Configuration
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# GitHub Organization (optional override, defaults to nub-coders)
GITHUB_ORG=nub-coders


# Cloudflare Turnstile (contact form bot protection).
# Site key is public and injected into the page at runtime; secret key is
# server-only. Leave both blank to disable the challenge entirely.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
