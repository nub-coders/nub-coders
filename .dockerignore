# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files — never copy real secrets into a build layer.
# `COPY . .` runs in the builder stage, so an un-ignored .env would be baked
# into that layer's filesystem and persist in the local/CI build cache.
.env
*.env
.env.*
!.env.example

# Build output
dist
.vite
.cache

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git
.gitignore

# Docker
Dockerfile
.dockerignore

# Documentation
README.md
*.md

# Logs
logs
*.log

# Temporary files
tmp
temp
